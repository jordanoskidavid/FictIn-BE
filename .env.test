# Test configuration. Committed on purpose: every value here is a safe fake.
# internal/testutil loads this file (it never reads .env) and replaces
# DATABASE_URL with the per-test database it creates.
APP_ENV=test
APP_PORT=0

DATABASE_URL=postgres://replaced-by-testutil/placeholder

JWT_ACCESS_SECRET=test-access-secret-not-for-production
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=168

QR_TOKEN_TTL_MS=1500
# Rotation is fast in tests so the WebSocket tests see several tokens quickly.
QR_ROTATION_INTERVAL_MS=50

# Minimum bcrypt cost keeps tests fast.
BCRYPT_COST=4

ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

CORS_ALLOWED_ORIGINS=*

# High enough that ordinary tests never trip it; rate-limit tests override it.
SCAN_RATE_LIMIT_PER_SEC=1000
SCAN_RATE_LIMIT_BURST=1000
