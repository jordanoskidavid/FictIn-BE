APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://attendance_app:attendance_local_pw@localhost:5432/attendance_db?sslmode=disable

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=168

QR_TOKEN_TTL_MS=1500
QR_ROTATION_INTERVAL_MS=1000

# Timeout for regular HTTP requests (the WebSocket QR stream is exempt)
HTTP_REQUEST_TIMEOUT_SECONDS=30

BCRYPT_COST=12

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# Comma-separated list of allowed CORS origins (use * only for local dev)
CORS_ALLOWED_ORIGINS=*

# Per-student rate limit for POST /api/v1/attendance/scan
SCAN_RATE_LIMIT_PER_SEC=5
SCAN_RATE_LIMIT_BURST=5
